<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Check Property</title>
</head>

<body>
    <h2>Property Details</h2>
    <h4> Property : <%= listing.title %>
    </h4>
    <h4> Brief : <%= listing.description %>
    </h4>
    <h4> Per night : &#8377 <%= listing.price.toLocaleString("en-IN") %>
    </h4>
    <h4> Location : <%= listing.location %>
    </h4>
    <h4> Country : <%= listing.country %>
    </h4>

    <form action="/listings/<%= listing._id %>/edit" method="GET">

        <button type="submit">Edit Listing</button>
    </form>
</body>

</html>