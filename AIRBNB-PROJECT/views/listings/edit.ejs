<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>

<body>
    <h2>Edit Listing</h2>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">


        <input type="text" name="title" placeholder="Title" value="<%= listing.title %>" required>
        <br> <br>
        <input type="text" name="description" placeholder="Description" value="<%= listing.description %>" required>
        <br> <br>
        <input type="number" name="price" placeholder="Price" value="<%= listing.price %>" required>
        <br> <br>
        <input type="text" name="location" placeholder="Location" value="<%= listing.location %>" required>
        <br> <br>
        <input type="text" name="country" placeholder="Country" value="<%= listing.country %>" required>
        <br> <br>
        <input type="text" name="imageName" placeholder="Image Heading" value="<%= listing.image.filename %>" required>
        <br> <br>
        <input type="text" name="imageUrl" placeholder="Image URL" value="<%= listing.image.url %>" required>
        <br> <br>
        <button type="submit">Update Listing</button>


    </form>


</body>

</html>