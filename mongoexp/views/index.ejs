<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
</head>
<link rel="stylesheet" href="style.css">

<body>
    <h2>ALL CHATS</h2>
    <form method="get" action="/chats/new">
        <button>Create Chat</button>
    </form>
    <br>
    <br>

    <% for(chat of chats){%>
        <div class="chat">
            <p> from : <i>
                    <%= chat.from %>
                </i>
            </p>
            <div class="msg">
                <p> message : <%= chat.message %>
                </p>
            </div>
            <p> to : <i>
                    <%= chat.to %>
                </i>
            </p>
            <hr>
        </div>
        <% }%>
</body>

</html>